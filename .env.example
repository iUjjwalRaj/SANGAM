# ==============================================================================
# SANGAM Configuration Template
# Copy to .env and adjust variables as needed for local or production deployment.
# ==============================================================================

# --- Backend Application Settings ---
APP_NAME=SANGAM
APP_ENV=development                       # Set to 'production' in production environments
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins
# Supports comma-separated list or JSON array.
# In production with a same-origin Cloudflare Worker proxy (/api/*), CORS is not needed.
# If deploying backend on a separate domain, specify the frontend domain(s) below:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Meteorological Providers & Ingestion ---
DEFAULT_DATA_MODE=auto                    # Options: 'auto' (live with demo fallback), 'live', 'demo'
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1

# --- Frontend Build Configuration (Vite) ---
# Default is '/api' for same-origin proxy via Cloudflare Worker.
# If the backend is hosted on a separate domain, set the absolute URL:
VITE_API_URL=/api

# --- Cloudflare Worker Settings ---
# URL of the upstream managed FastAPI backend to proxy /api/* requests:
BACKEND_API_URL=http://127.0.0.1:8000
