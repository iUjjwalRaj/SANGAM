# SANGAM Environment Variables
APP_NAME=SANGAM
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Forecast Providers Settings
